{
  "name": "Go + Postgres Dev Container",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "dev_environment",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "/workspace/.devcontainer/setup.sh",
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "forwardPorts": [
    5432,
    8080,
    5173
  ],
  "containerEnv": {
    "TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE": "/var/run/docker.sock",
    "DOCKER_HOST": "unix:///var/run/docker.sock",
    "GOROOT": "/usr/local/go",
    "GOPATH": "/root/go",
    "PATH": "/root/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/go/bin"
  },
  "remoteEnv": {
    "TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE": "/var/run/docker.sock",
    "DOCKER_HOST": "unix:///var/run/docker.sock",
    "GOROOT": "/usr/local/go",
    "GOPATH": "/root/go",
    "PATH": "/root/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/go/bin"
  },
  "remoteUser": "root",
  "customizations": {
    "jetbrains": {
      "settings": {
        "com.intellij:app:ProjectViewSharedSettings.hideEmptyPackages": false,
        "com.intellij:app:HttpConfigurable.use_proxy_pac": true,
        "com.intellij:app:BaseRefactoringSettings.move_search_for_references_for_file": false
      }
    },
    "vscode": {
      "settings": {
        "go.toolsManagement.autoUpdate": true,
        "go.goroot": "/usr/local/go",
        "go.alternateTools": {
          "go": "/usr/local/go/bin/go"
        }
      },
      "extensions": [
        "golang.go",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
